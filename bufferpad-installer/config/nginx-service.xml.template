<service>
  <id>{{NGINX_SERVICE_NAME}}</id>
  <name>{{NGINX_SERVICE_NAME}}</name>
  <description>Buffer pad nginx frontend service.</description>
  <executable>{{NGINX_EXE}}</executable>
  <arguments>-p "{{NGINX_HOME}}" -c conf/nginx.conf</arguments>
  <workingdirectory>{{NGINX_HOME}}</workingdirectory>
  <stopexecutable>{{NGINX_EXE}}</stopexecutable>
  <stoparguments>-p "{{NGINX_HOME}}" -s stop</stoparguments>
  <logpath>{{NGINX_SERVICE_LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
  <depend>{{BACKEND_SERVICE_NAME}}</depend>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
</service>
