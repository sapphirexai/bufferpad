param([string]$Username = 'admin')
$ErrorActionPreference = 'Stop'
$secret = Read-Host 'New temporary administrator password (8-64 characters)' -AsSecureString
$pointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secret)
try {
    $env:BUFFERPAD_RECOVERY_PASSWORD = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer)
    $env:BUFFERPAD_RECOVERY_USERNAME = $Username
    & '{{JAVA_EXE}}' '-Dloader.main=cn.tpl.opc.auth.AdminRecovery' '-cp' '{{BACKEND_JAR}}' 'org.springframework.boot.loader.PropertiesLauncher' '--spring.profiles.active=prod' '--spring.config.additional-location=file:///{{CONF_DIR}}/'
    if ($LASTEXITCODE -ne 0) { throw 'Administrator recovery failed. Check the account name and database configuration.' }
} finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer)
    Remove-Item Env:BUFFERPAD_RECOVERY_PASSWORD -ErrorAction SilentlyContinue
    Remove-Item Env:BUFFERPAD_RECOVERY_USERNAME -ErrorAction SilentlyContinue
}
