# Local dependencies and generated output
**/node_modules/
/bufferpad/dist/
/bufferpad/coverage/
/bufferpad/opc-web.tar
/wms-opc/target/
**/logs/
*.log
*.log.*
*.[pP][dD][fF]
**/.idea/
*.iml
.DS_Store
Thumbs.db
*.download
/.env
/.env.*
!/.env.example

# Runtime dependencies and private/local build artifacts
/wms-opc/src/main/resources/lib/*.jar
/bufferpad-installer/packages/*
!/bufferpad-installer/packages/README.md
!/bufferpad-installer/packages/.gitkeep
/bufferpad-installer/app/backend/*
!/bufferpad-installer/app/backend/README.md
!/bufferpad-installer/app/backend/.gitkeep
/bufferpad-installer/app/frontend/*
!/bufferpad-installer/app/frontend/README.md
!/bufferpad-installer/app/frontend/.gitkeep
/bufferpad-installer/config/install.local.ps1
/wms-opc/config/
/output/
/tmp/
*.bundle
# Deployment credentials must never enter public history.
ssh_key
ssh_key.pub
id_rsa
id_ed25519
*.pem
*.p12
*.pfx
